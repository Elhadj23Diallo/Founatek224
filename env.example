# Modèle du fichier .env (à copier en .env sur le serveur, jamais commité).
# Remplace chaque valeur ; ne mets jamais de vraie clé dans ce fichier-ci.

# --- Django ---
DJANGO_SECRET_KEY=
# false uniquement en local sans HTTPS (runserver sur 192.168.x.x)
DJANGO_SECURE_COOKIES=true
# Reçoit les alertes d'erreur (sinon : DEFAULT_FROM_EMAIL)
DJANGO_ADMIN_EMAIL=

# --- E-mail (Gmail : mot de passe d'application) ---
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# --- Paiements ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_MODE=live
PAYPAL_WEBHOOK_ID=
# Ouvre la vente du pack Livre 1
ACADEMY_BOOK_CHECKOUT_ENABLED=false
# Abonnements par carte avec renouvellement automatique
STRIPE_AUTO_RENEW_ENABLED=false

# --- Pages légales (mentions, CGV, confidentialité) ---
LEGAL_NAME=FOUNATEK
LEGAL_OWNER=
LEGAL_FORM=
LEGAL_ADDRESS=
LEGAL_SIRET=
LEGAL_VAT=
LEGAL_EMAIL=
LEGAL_PHONE=
LEGAL_MEDIATOR=

# --- Sauvegardes (par défaut ~/founatek_backups) ---
BACKUP_DIR=

# --- IA ---
GEMINI_API_KEY=
